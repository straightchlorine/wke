    {
      "id": "1378316402:1:4",
      "kind": "prose",
      "citation_id": "c10",
      "heading_path": [
        "Geography"
      ],
      "order": 7,
      "text": "The obvious circular area in the central valley is the Klyuchevskaya Sopka, an isolated volcanic group southeast of the curve of the Kamchatka River. West of Kronotsky Point is the Kronotsky Biosphere Reserve with the Valley of Geysers. At the southern tip is the Southern Kamchatka Wildlife Refuge with Kurile Lake. There are several other protected areas on the peninsula.",
      "est_tokens": 94,
      "relevance": 0.6099352240562439,
      "cluster_id": 0,
      "links": [
        {
          "start": 55,
          "end": 74,
          "title": "Klyuchevskaya Sopka"
        },
        {
          "start": 181,
          "end": 190,
          "title": "Kronotsky"
        },
        {
          "start": 218,
          "end": 235,
          "title": "Valley of Geysers"
