{
  "name": "wke-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite",
    "regenerate": "openapi-ts",
    "lint": "oxlint --type-aware --deny-warnings src scripts e2e e2e-live vite.config.ts vitest.config.ts playwright.config.ts openapi-ts.config.ts",
    "check:hex": "! grep -rnE '#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})\\b' src --include='*.ts' --include='*.tsx' --include='*.css' --exclude=tokens.css",
    "check:contrast": "python3 scripts/contrast.py",
    "build": "vite build && node scripts/notices.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=desktop-1440 home.spec.ts dossier.spec.ts dossiers.spec.ts machines.spec.ts seo.spec.ts noRuntimeErrors.spec.ts serverDown.spec.ts searchCombobox.spec.ts",
    "verify": "pnpm build && pnpm format:check && pnpm lint && pnpm check:hex && pnpm check:contrast && pnpm typecheck && pnpm test --coverage",
    "verify:e2e": "pnpm build && pnpm e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-polygon": "3.0.1",
    "d3-selection": "3.0.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@hey-api/openapi-ts": "0.0.0-next-20260824173136",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.41",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/babel__core": "7.20.5",
    "@types/d3-drag": "3.0.7",
    "@types/d3-force": "3.0.10",
    "@types/d3-polygon": "3.0.2",
    "@types/d3-selection": "3.0.12",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "29.0.1",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
