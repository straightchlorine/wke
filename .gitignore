# Python bytecode and compiled extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Python packaging output, anchored to the two uv projects: an unanchored
# build/ would hide the source package backend/api/src/wke/jobs/build/
backend/*/build/
backend/*/dist/
*.egg-info/

# test, coverage and type-checker caches
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
.pytype/
.ruff_cache/

# logs
*.log

# environments and secrets
.env
.venv
venv/
env/
ENV/

# Jupyter checkpoints
.ipynb_checkpoints

# editor and tool config files
.pdm.toml
poetry.toml
pyrightconfig.json
.pybuilder/
cython_debug/

# node and frontend build output
node_modules/
/frontend/app/dist/

# local agent tooling; the dossier-control skill is tracked because scripts and eval data depend on it
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/dossier-control/
.impeccable/
.gstack/
.playwright-mcp/

# the lab leaves the repo (separate project); stops a half-moved tree from being committed
/notebooks/

# internal docs: track README, spec, decisions, design brief, audit and plans
docs/internal/*
!docs/internal/README.md
!docs/internal/architecture/
!docs/internal/decisions/
!docs/internal/design/
!docs/internal/audit-2026-10-25/
!docs/internal/plans/
docs/internal/design/mockups/
docs/internal/design/candidates/

# owner decision 2: product statement stays local until the owner publishes it
/PRODUCT.md

# local run outputs (justfile)
/.run/

# eval scripts are source; their bytecode is not
backend/api/scripts/**/__pycache__/

# agent scratch space and stray screenshots
/.scratchpad/
/b4/
/*.png
/frontend/app/undefined/
tmp-files/

# Sphinx/mkdocs output
docs/_build/
/site
