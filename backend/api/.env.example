# Wikipedia Knowledge Explorer - wke-api environment variables.
#
# Copy to `.env` and adjust per environment. The values below are for an api
# started on the host; docker compose sets the container addresses itself.

# REQUIRED. Wikipedia Action API endpoint.
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# REQUIRED. Wikipedia REST API endpoint.
WIKIPEDIA_REST_URL=https://en.wikipedia.org/w/rest.php/v1

# REQUIRED. EventStreams recentchange endpoint for wke-watcher.
WIKIMEDIA_EVENTSTREAMS_URL=https://stream.wikimedia.org/v2/stream/recentchange

# REQUIRED. Wikifeeds featured-feed base URL for wke-trending.
WIKIFEEDS_URL=https://en.wikipedia.org/api/rest_v1/feed/featured

# REQUIRED. wke-ml base URL: compose publishes wke-ml on localhost:8001.
# The justfile exports its own value and overrides this file.
ML_URL=http://localhost:8001

# REQUIRED. Redis connection URL shared by cache, queue and counters.
REDIS_URL=redis://localhost:6379/0

# REQUIRED. Public hostname (also the MCP allowed host).
PUBLIC_HOST=localhost:8080

# Scheme used to build every public-facing absolute URL.
# Default: https. For local dev it must be overridden.
PUBLIC_SCHEME=http

# REQUIRED. Contact address embedded in the Wikimedia User-Agent.
WKE_CONTACT_EMAIL=dev@example.com

# REQUIRED. CIDR of the reverse proxy in front of the api, for uvicorn
# --forwarded-allow-ips.
# Any value works for local dev; it only matters behind a real proxy.
POD_CIDR=127.0.0.1/32

# REQUIRED. Pipeline version string embedded in dossier and job keys.
# Bump it whenever the pipeline output changes, so cached dossiers are rebuilt;
# the deployed value must be set deliberately.
PIPELINE_VERSION=dev

# Allowed CORS origins, comma-separated. Default: empty list (fail-closed).
CORS_ORIGINS=http://localhost:8080

# Most sections summarized per dossier build. Default: 8
# SUMMARY_SECTIONS=8

# Deadline in ms sent to wke-ml /v1/analyze, also the call's timeout. Default: 8000
# Keep one attempt under the 20 s the MCP get_dossier tool waits for a partial build.
# ANALYZE_DEADLINE_MS=8000

# Extra analyze attempts after a failure (4xx never retried). Default: 0
# A 503 shed by wke-ml after waiting most of the deadline is retried even without RETRY_ON_TIMEOUT.
# ANALYZE_RETRIES=0

# Pause in ms between analyze attempts. Default: 1000
# ANALYZE_RETRY_PAUSE_MS=1000

# Also retry an analyze timeout. Default: false
# ANALYZE_RETRY_ON_TIMEOUT=false

# Lifetime in seconds of a structural dossier (wke-ml unavailable). Default: 600
# DOSSIER_STRUCTURAL_TTL_SECONDS=600

# Beam count passed to wke-ml /v1/summarize. Default: 1
# NUM_BEAMS=1

# Structural-dossier Markdown names the subsection where passages jump between
# subsections; false leaves the headings out. Default: true
# SUBSECTION_HEADINGS=true

# Pack by a local model's 0 to 3 rating of each passage, rated in the background through
# wke-ml /v1/rate (needs WKE_ML_RATING_MODEL_PATH). Off: nothing is rated. Default: false
# SELECTION_RATING=false

# Longest one rating attempt of an article, in seconds; the next resumes it. Default: 1800
# RATING_DEADLINE_SECONDS=1800

# Timeout of one wke-ml rating call (one passage), in seconds. Default: 120
# RATING_CALL_TIMEOUT_SECONDS=120

# wke-ml must run the model file gemma-4-E4B-it-Q4_K_M.gguf; the rater checks only the
# file name, so any other name ends every stage as "mismatch".

# Share of prose passages that need a real score for the rating to apply; below it the
# stored relevance packs. Default: 0.9
# RATING_MIN_COVERAGE=0.9

# Failed rating attempts without a new score before a stage is dropped until the next
# build. Default: 3
# RATING_MAX_ATTEMPTS=3

# Seconds before a failed stage is retried; doubles per attempt. Default: 60
# RATING_RETRY_BACKOFF_SECONDS=60

# Python logging level name. Default: INFO
# LOG_LEVEL=INFO

# Log line format: json (one object per line, for a log collector) or console
# (colored lines for a terminal). Default: json
LOG_FORMAT=console

# Max depth of q:interactive before an admission gets 503 queue_full.
# Default: 20
# QUEUE_CAP=20

# Max depth of q:background (nightly prebuilds); kept above the 40 trending
# topics so one run never trips it. Default: 50
# BACKGROUND_QUEUE_CAP=50

# true leaves the Key facts block and the per-section "left out" lines out of responses
# and the budget (parts=dossier,metadata brings them back). Default: true
# LEAN_RESPONSE=true

# true lets the 2000 budget trade its weakest extra passages for more table rows and
# list items, when that shows more of them; the other budgets are never repacked.
# Default: true
# TABLE_REPACK=true

# Shared Wikimedia call budget per epoch minute. Default: 150
# WM_BUDGET_PER_MINUTE=150

# TCP port the watcher (python -m wke.watcher) serves /metrics on. Change it
# when 8000 is taken on the host (the API and the watcher on one machine).
# Default: 8000
# WATCHER_METRICS_PORT=8000

# Ports used by the justfile (`just up`). Defaults shown; uncomment to override
# when a port is taken on your machine. URLs derived from them are rebuilt by
# the justfile, so ML_URL, PUBLIC_HOST and CORS_ORIGINS above are ignored there.
# WKE_PORT=8000
# ML_PORT=8001
# WEB_PORT=8080
# REDIS_PORT=6379
# WATCHER_METRICS_PORT=8002
