# Wikipedia Knowledge Explorer - wke-api environment variables.
#
# Copy to `.env` and adjust per environment.

# REQUIRED. Wikipedia Action API endpoint.
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# REQUIRED. Wikipedia REST API endpoint.
WIKIPEDIA_REST_URL=https://en.wikipedia.org/w/rest.php/v1

# REQUIRED. EventStreams recentchange endpoint for wke-watcher.
WIKIMEDIA_EVENTSTREAMS_URL=https://stream.wikimedia.org/v2/stream/recentchange

# REQUIRED. Wikifeeds featured-feed base URL for wke-trending.
WIKIFEEDS_URL=https://en.wikipedia.org/api/rest_v1/feed/featured

# REQUIRED. wke-ml base URL (ClusterIP in cluster; local compose service in dev).
ML_URL=http://ml:8000

# REQUIRED. Redis connection URL shared by cache, queue and counters.
REDIS_URL=redis://redis:6379/0

# REQUIRED. Public hostname (also the MCP allowed host).
PUBLIC_HOST=localhost:8080

# Scheme used to build every public-facing absolute URL.
# Default: https. For local dev it must be overridden.
PUBLIC_SCHEME=http

# REQUIRED. Contact address embedded in the Wikimedia User-Agent.
WKE_CONTACT_EMAIL=dev@example.com

# REQUIRED. Traefik/ingress pod CIDR for uvicorn --forwarded-allow-ips.
# Any value works for local dev; it only matters behind a real proxy.
POD_CIDR=127.0.0.1/32

# REQUIRED. Pipeline version string embedded in dossier and job keys.
PIPELINE_VERSION=dev

# Allowed CORS origins, comma-separated. Default: empty list (fail-closed).
CORS_ORIGINS=http://localhost:8080

# Number of top sections summarized per dossier build. Default: 3
# SUMMARY_SECTIONS=3

# Beam count passed to wke-ml /v1/summarize. Default: 1
# NUM_BEAMS=1

# Python logging level name. Default: INFO
# LOG_LEVEL=INFO

# Max depth of q:interactive before an admission gets 503 queue_full.
# Default: 20
# QUEUE_CAP=20

# Max depth of q:background (nightly prebuilds); kept above the 40 trending
# topics so one run never trips it. Default: 50
# BACKGROUND_QUEUE_CAP=50

# Shared Wikimedia call budget per epoch minute. Default: 150
# WM_BUDGET_PER_MINUTE=150

# TCP port the watcher (python -m wke.watcher) serves /metrics on. Change it
# when 8000 is taken on the host (the API and the watcher on one machine).
# Default: 8000
# WATCHER_METRICS_PORT=8000
